{
  "permissions": {
    "allow": [
      "Bash(git add:*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/akira/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/script.sh"
  },
  "tui": "fullscreen",
  "verbose": true,
  "preferredNotifChannel": "ghostty"
}
